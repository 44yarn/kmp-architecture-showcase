root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
max_line_length = 130
ktlint_code_style = android_studio
ktlint_function_naming_ignore_when_annotated_with = Composable

# Import layout order.
ij_kotlin_imports_layout = java,javax,kotlin,android,^,*

# Disable trailing comma rules.
ktlint_standard_trailing-comma-on-call-site = disabled
ktlint_standard_trailing-comma-on-declaration-site = disabled

# Don't enforce specific function styles.
ktlint_standard_function-expression-body = disabled
ktlint_standard_function-literal = disabled
ktlint_standard_function-signature = disabled

# NOTE: With ktlint 1.7.1, disabling the class-signature rule or setting its
#   threshold property through .editorconfig did not take effect. For the
#   files that need it, we annotate the class directly with
#   @Suppress("ktlint:standard:class-signature").

# Disable property-naming (to accommodate KMP constant patterns).
ktlint_standard_property-naming = disabled

# Disable the filename rule (expect/actual KMP files sometimes don't match
# the Kotlin filename convention).
ktlint_standard_filename = disabled

[*.{kt,kts,gradle.kts}]
insert_final_newline = true
trim_trailing_whitespace = true
